{
  "name": "gcc-despachos",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @gcc/web dev",
    "dev:api": "pnpm --filter @gcc/api dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @gcc/api test",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.23.4 || >=24.22.1"
  },
  "pnpm": {
    "overrides": {
      "body-parser": ">=1.20.9",
      "proxy-addr": ">=2.0.8"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
